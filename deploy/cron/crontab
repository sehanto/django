# BukuUMKM scheduled jobs. Times are in the server's time zone (WIB on Asia/Jakarta servers).
# Install with deploy/cron/install.sh, which fills in the project path.
# Uncomment MAILTO to receive failures by email (needs a working local mailer).
# MAILTO=ops@example.com

# Daily: close expired payment links, send renewal reminders, downgrade lapsed plans.
15 1 * * * @PROJECT_DIR@/deploy/cron/run.sh process_billing

# Daily: recompute the hash chain of posted journal entries; a failure is mailed (MAILTO).
0 4 * * * @PROJECT_DIR@/deploy/cron/run.sh verify_ledger

# Daily: delete sign-in/security records after SECURITY_LOG_RETENTION_DAYS (90) and
# organization/subscription/system audit events after ORGANIZATION_LOG_RETENTION_DAYS (3650),
# blanking their IP address and browser after 90 days.
# Needs DATABASE_OWNER_URL.
30 3 * * * @PROJECT_DIR@/deploy/cron/run.sh prune_security_logs
