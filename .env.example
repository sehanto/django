DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://msme_user:CHANGE_ME@localhost:5432/msme_db

# Subscription billing: "fake" for local development, "xendit" with real keys.
BILLING_GATEWAY=fake
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
BILLING_SELLER_NAME=BukuUMKM
BILLING_SELLER_NPWP=
BILLING_SELLER_ADDRESS=

# Login rate limiting (django-axes).
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
# Reverse proxies in front of Django that append to X-Forwarded-For (0 = none, 1 = nginx).
TRUSTED_PROXY_COUNT=0
