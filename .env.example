# Values are read exactly as written: "$" is an ordinary character, never a reference to another variable.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The app connects as a data-only role; migrate/createcachetable/tests use the owner.
# One role for both also works locally: set DATABASE_URL to the owner and omit DATABASE_OWNER_URL.
# Create the app role: deploy/postgres/create_app_role.sql (README "Database roles").
DATABASE_URL=postgres://msme_app:CHANGE_ME@localhost:5432/msme_db
DATABASE_OWNER_URL=postgres://msme_user:CHANGE_ME@localhost:5432/msme_db

# Subscription billing: "fake" for local development, "xendit" with real keys.
BILLING_GATEWAY=fake
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# Automatic renewal: Payment Requests API version and how many days before the end to charge.
# XENDIT_PAYMENT_REQUEST_API_VERSION=2024-11-11
# BILLING_AUTO_RENEW_DAYS_BEFORE=1
# The platform's own Coretax connection for subscription fakturs: "" (files only), "fake" or "http".
# CORETAX_CONNECTOR=
# CORETAX_API_URL=
# CORETAX_API_TOKEN=
# REST API: requests per key per hour.
# API_REQUESTS_PER_HOUR=1000

# Login CAPTCHA (Cloudflare Turnstile), shown after repeated failed sign-ins.
# Unset = Cloudflare's always-pass test keys (development only; production requires real keys).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
LOGIN_CAPTCHA_AFTER_FAILURES=2
LOGIN_CAPTCHA_WINDOW_MINUTES=60
BILLING_SELLER_NAME=EA-System
BILLING_SELLER_NPWP=
# Street line only; the region comes from the Kemendagri code of the kelurahan/desa (e.g. 36.03.22.2008).
BILLING_SELLER_ADDRESS=
BILLING_SELLER_VILLAGE=

# Login rate limiting (django-axes).
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
# Reverse proxies in front of Django that append to X-Forwarded-For (0 = none, 1 = nginx).
TRUSTED_PROXY_COUNT=0

# Public address used in emails (password reset, billing reminders).
SITE_URL=http://localhost:8000
SITE_NAME=EA-System
DEFAULT_FROM_EMAIL=EA-System <noreply@ea-system.id>
# Production: SMTP and a cache shared by all workers.
# EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
# CACHE_URL=dbcache://django_cache
PASSWORD_RESET_TIMEOUT=3600

# Encryption keys for 2FA secrets in the database (Fernet, newest first; required in production).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEYS=

# Signed checkpoints of the ledger and audit trail hash chains (verify_ledger, verify_audit_trail):
# a file outside the database, best on append-only storage. Empty turns them off.
# CHAIN_CHECKPOINT_FILE=/var/lib/ea-system/checkpoints/chains.jsonl
