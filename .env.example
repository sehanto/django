DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://msme_user:CHANGE_ME@localhost:5432/msme_db

# Subscription billing: "fake" for local development, "xendit" with real keys.
BILLING_GATEWAY=fake
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
BILLING_SELLER_NAME=BukuUMKM
BILLING_SELLER_NPWP=
BILLING_SELLER_ADDRESS=

# Login rate limiting (django-axes).
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15
# Reverse proxies in front of Django that append to X-Forwarded-For (0 = none, 1 = nginx).
TRUSTED_PROXY_COUNT=0

# Public address used in emails (password reset, billing reminders).
SITE_URL=http://localhost:8000
SITE_NAME=BukuUMKM
DEFAULT_FROM_EMAIL=BukuUMKM <noreply@bukuumkm.id>
# Production: SMTP and a cache shared by all workers.
# EMAIL_URL=smtp+tls://user:password@smtp.example.com:587
# CACHE_URL=dbcache://django_cache
PASSWORD_RESET_TIMEOUT=3600

# Encryption keys for 2FA secrets in the database (Fernet, newest first; required in production).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEYS=
