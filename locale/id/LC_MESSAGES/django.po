msgstr "baris dilewati"

#: apps/uploads/models.py:23
msgid "summary"
msgstr "ringkasan"

#: apps/uploads/models.py:28
msgid "file upload"
msgstr "unggahan berkas"

#: apps/uploads/models.py:29
msgid "file uploads"
msgstr "unggahan berkas"

#: apps/uploads/services.py:75
#, python-format
msgid "This file was already applied on %(date)s."
msgstr "Berkas ini sudah diterapkan pada %(date)s."

#: apps/uploads/services.py:99
msgid "This file was just applied."
msgstr "Berkas ini baru saja diterapkan."

#: apps/uploads/views.py:93
msgid "Too many files checked in the last hour. Please try again later."
msgstr "Terlalu banyak berkas yang diperiksa dalam satu jam terakhir. Silakan coba lagi nanti."

#: apps/uploads/views.py:120
msgid "The checked file has expired: upload it again."
msgstr "Berkas yang sudah diperiksa kedaluwarsa: unggah lagi."

#: apps/uploads/views.py:124
msgid "The options of the checked file are no longer valid: upload it again."
msgstr "Pilihan untuk berkas yang sudah diperiksa tidak berlaku lagi: unggah lagi."

#: apps/uploads/views.py:135
#, python-format
msgid "%(file)s applied: %(count)s row recorded."
msgid_plural "%(file)s applied: %(count)s rows recorded."
msgstr[0] "%(file)s diterapkan: %(count)s baris dicatat."

